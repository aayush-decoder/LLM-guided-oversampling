{
  "version": "v1",
  "dataset": "iris",
  "method": "pred_llm",
  "seed": 1,
  "llm": "qwen3-0.6b",
  "mode": "auto",
  "device": "auto",
  "data": {
    "test_size": 0.2,
    "train_size": 1.0,
    "gen_size": 1.0,
    "fit_scaler_on": "full",
    "decimals": 2,
    "binarize": null,
    "max_rows": null
  },
  "finetune": {
    "epochs": 50,
    "batch_size": 32,
    "micro_batch_size": null,
    "lr": 5e-05,
    "lr_lora": 0.0002,
    "weight_decay": 0.0,
    "warmup_ratio": 0.0,
    "max_grad_norm": 1.0,
    "max_steps": null,
    "log_every": 50,
    "reuse": true
  },
  "sampling": {
    "temperature": 0.7,
    "top_k": 50,
    "batch_size": 100,
    "max_rounds": 30,
    "target_decimals": 4,
    "clip": 10
  },
  "query": {
    "max_retries": 5,
    "force_target_key": true
  },
  "eval": {
    "runs": 3,
    "fidelity": true,
    "max_fidelity_rows": 5000
  },
  "baselines": {
    "epochs": 300
  }
}