{
  "version": "v3",
  "dataset": "iris",
  "method": "v3_cfg_negative",
  "seed": 2,
  "llm": "distilgpt2",
  "mode": "auto",
  "device": "auto",
  "serialization": "raw",
  "range_mode": "outlier",
  "data": {
    "test_size": 0.2,
    "train_size": 1.0,
    "gen_size": 1.0,
    "fit_scaler_on": "full",
    "decimals": 2,
    "binarize": null,
    "max_rows": null,
    "max_value_decimals": 4
  },
  "outlier": {
    "mode": "iqr",
    "factor": 1.5,
    "contamination": 0.1
  },
  "finetune": {
    "epochs": 50,
    "batch_size": 32,
    "micro_batch_size": null,
    "lr": 5e-05,
    "lr_lora": 0.0002,
    "weight_decay": 0.0,
    "warmup_ratio": 0.03,
    "max_grad_norm": 1.0,
    "max_steps": null,
    "log_every": 50,
    "reuse": true,
    "perm_copies": 1,
    "orig_copies": 1,
    "negative_weight": 0.5
  },
  "loss": {
    "target_weight": 3.0,
    "scaffold_weight": 0.0
  },
  "decoding": {
    "batch_size": 64,
    "temperature_num": 0.7,
    "temperature_cat": 1.0,
    "kv_cache": true,
    "max_score_elems": 30000000,
    "negative_guidance": 0.0
  },
  "query": {
    "permutations": 4,
    "label_decode": "sample",
    "temperature_y": 0.7,
    "reg_aggregate": "mean",
    "minority_prior_boost": 0.0
  },
  "curation": {
    "enabled": true,
    "pool_factor": 1.5,
    "privacy_gate": true,
    "privacy_alpha": 0.01,
    "max_drop": 0.5,
    "anomaly_gate": true,
    "anomaly_quantile_low": 0.0,
    "anomaly_quantile_high": 0.9,
    "sir": true,
    "beta": 1.0,
    "clip": 20.0,
    "folds": 5
  },
  "eval": {
    "runs": 3,
    "fidelity": true,
    "max_fidelity_rows": 5000
  },
  "baselines": {
    "epochs": 300
  }
}